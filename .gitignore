# Python
.venv/
__pycache__/
*.py[cod]
*.pyo

# Jupyter 
.ipynb_checkpoints/

# Generierte Ausgaben 
# CSV/JSON/PNG werden bei jedem Skript-/Container-Lauf neu erzeugt.
# Verzeichnisstruktur bleibt über .gitkeep erhalten.
outputs/tables/*
outputs/figures/*
outputs/models/*
!outputs/**/.gitkeep
# Matplotlib-Cache (von der PCA-Visualisierung des Word2Vec-Prototyps angelegt)
outputs/.matplotlib/

# Word2Vec-Korpusdaten (Download-Archiv + tokenisierte Zwischenstände)
data/

# HuggingFace-Modell-Cache
# Lokal gecachte Modelle (außerhalb des Docker-Volumes)
.cache/
*.bin
*.safetensors

# Claude Code Projektanweisungen (lokal behalten, nicht ins Repo)
CLAUDE.md

# IDEs & Editoren
.vscode/
.idea/
*.swp
*.swo

